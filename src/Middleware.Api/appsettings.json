{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ApiKey": {
    "HeaderName": "X-Api-Key",
    "Value": ""
  },
  "Sap": {
    "BaseUrl": "http://10.10.41.4:50001/b1s/v1/",
    "CompanyDb": "COMPANY",
    "UserName": "USER",
    "Password": "",
    "TimeoutSeconds": 30,
    "MaxConcurrentSapCalls": 10,
    "ThrottleWaitSeconds": 8,
