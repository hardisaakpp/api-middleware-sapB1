{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Sap": {
    "BaseUrl": "https://YOUR_SAP_SERVER:50000/b1s/v2/",
    "CompanyDb": "YOUR_COMPANY_DB",
    "UserName": "YOUR_SAP_USERNAME",
    "Password": "",
    "TimeoutSeconds": 30,
    "MaxConcurrentSapCalls": 5,
    "TestCompanyDb": "YOUR_TEST_COMPANY_DB"
  },
  "Sql": {
    "ConnectionString": ""
  },
  "OpenTelemetry": {
    "Endpoint": ""
  }
}
